# Local development only. Production values are injected by Cloud Run/Secret Manager.
ENVIRONMENT=development
GCP_PROJECT_ID=vaani-sovereign-dpi
GCP_REGION=asia-south1
VERTEX_AI_LOCATION=asia-south1
USE_VERTEX_AI=true
ALLOW_DEV_AUTH=true
DEV_OPERATOR_TOKEN=dev-operator
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OPERATOR_EMAILS=local-operator@localhost
GOOGLE_OPERATOR_DOMAINS=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC_INTAKE=citizen-intake-events
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
NEXT_PUBLIC_API_URL=http://localhost:8000
